set -l spec_dir (if set -q XDG_CACHE_HOME; echo $XDG_CACHE_HOME; else; echo $HOME/.cache; end)/usage
test -d "$spec_dir"; or mkdir -p -m 700 "$spec_dir"
set -l spec_file "$spec_dir/usage__usage_spec_raskin.spec"
raskin --usage-spec | string collect > "$spec_file"

# stderr is discarded: a line that doesn't parse (`raskin help <Tab>`) makes
# complete-word fail, and its error would be printed over the prompt.
# The word being completed is cut at the cursor (`-c`) and unquoted, so
# `'prod<Tab>` and `sub\ dir/<Tab>` match the same values as their bare
# spellings; fish re-quotes whatever it inserts.
if commandline -x >/dev/null 2>&1
    complete -xc raskin -a "(command usage complete-word --shell fish -f \"$spec_file\" -- (commandline -xpc) (commandline -ct | string unescape) 2>/dev/null)"
else
    complete -xc raskin -a "(command usage complete-word --shell fish -f \"$spec_file\" -- (commandline -opc) (commandline -ct | string unescape) 2>/dev/null)"
end
