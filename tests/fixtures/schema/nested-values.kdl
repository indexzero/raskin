// A synthetic domain demonstrates data types, not known macOS settings.
// inline=meta illustrates optional descriptive metadata. It is not captured setting data.
raskin 1

defaults {
    org {
        example {
            raskin-fixture {
                enabled #true inline=meta
                count 1 inline=meta
                scale 1.0 inline=meta
                title "A window" inline=meta
                updated (date-time)"2026-10-30T15:04:05Z" inline=meta
                bytes (base64)"AAEP" inline=meta
                archivedObject (plist-uid)42 inline=meta

                (dict)window {
                    (dict)frame {
                        x 12.0 inline=meta
                        y 24.0 inline=meta
                        width 1280.0 inline=meta
                        height 800.0 inline=meta
                    }
                    (array)tabs "Work" "Notes" "Work"
                    (array)singleTab "Work"
                    (array)emptyTabs {}
                    (dict)emptyOptions {}
                }

                (array)workspaces {
                    (dict)- {
                        name "Writing" inline=meta
                        (array)items "Notes" "Draft"
                    }
                    (dict)- {
                        name "Reading" inline=meta
                        (array)items {}
                    }
                }
            }
        }
    }
}
