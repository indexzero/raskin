#!/bin/sh
# Generated by Raskin. Inspect before running on the destination Mac.
# Native commands below define their own effects.

# pmset: battery
sudo /usr/bin/pmset -b 'displaysleep' '2'
sudo /usr/bin/pmset -b 'sleep' '1'

# pmset: charger
sudo /usr/bin/pmset -c 'displaysleep' '120'
sudo /usr/bin/pmset -c 'sleep' '0'

# pmset: ups
sudo /usr/bin/pmset -u 'haltlevel' '20'
