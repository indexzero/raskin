// @generated by usage-cli from clap metadata
name raskin
bin raskin
version "0.1.0"
about "Read macOS preferences into KDL and generate native commands"
long_about "Capture persisted macOS preferences as editable KDL, then generate a standalone .macos file. Raskin never executes generated commands. Capture is broad by default; desktop, input, and power select curated subsets."
usage "Usage: raskin [COMMAND]"
flag --usage-spec help="Emit the jdx/usage interface specification" hide=#true
cmd capture help="Read persisted preferences into KDL" after_help=#"""
Examples:
  raskin capture --preset input -o input.kdl
  raskin capture --from ./saved-inputs -o saved.kdl
"""# {
    long_help "Read explicit persisted user, host, system and container preferences plus native power profiles. Unsupported or unreadable sources are recorded. No settings are changed. With --from, only the supplied offline tree is read; there is no live fallback."
    flag --preset help="Capture broad settings or a curated subset" default=broad {
        arg <PRESET> {
            choices broad desktop input power
        }
    }
    flag --from help="Read an offline tree containing user/, system/, containers/, host-id.txt, and pmset.txt" {
        arg <DIRECTORY>
    }
    flag "-o --output" help="Write KDL to this path; otherwise use stdout" {
        arg <FILE>
    }
    flag --force help="Atomically replace an existing output file"
}
cmd generate help="Generate a standalone .macos file from saved KDL" after_help=#"""
Examples:
  raskin generate myprefs.kdl -o myprefs.macos
  raskin generate myprefs.kdl --skip-unsupported -o partial.macos
  raskin generate - < myprefs.kdl
"""# {
    long_help "Validate saved KDL and emit native commands for a human to inspect and run. Generation never reads host settings or executes commands. Unsupported values fail before any output unless --skip-unsupported explicitly requests a partial script."
    flag "-o --output" help="Write the script to this path; otherwise use stdout" {
        arg <FILE>
    }
    flag --force help="Atomically replace an existing output file"
    flag --skip-unsupported help="Omit unsupported settings and name every omission in comments and diagnostics"
    arg <INPUT> help="KDL input path, or - to read stdin"
}
